# Settings for ./deploy.sh on your machine. Copy to .env.deploy (git-ignored) and fill in.

# Image to build and push. You must be logged in to this registry (docker login).
IMAGE=ghcr.io/YOUR_ORG/message-hub

# Public address of the deployed app; used to wait for the new version after a deploy.
PUBLIC_URL=https://message-hub.example.com

# Dokploy redeploy trigger. Leave empty to push the image only and redeploy by hand.
#   DOKPLOY_URL      address of your Dokploy panel, no trailing slash
#   DOKPLOY_API_KEY  Dokploy → Settings → Profile → API/CLI → Generate token
#   DOKPLOY_APP_ID   the applicationId of the Message Hub application (last part of its URL in the panel)
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_APP_ID=
