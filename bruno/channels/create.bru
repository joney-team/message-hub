meta {
  name: Create channel
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/channels
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
{
  "name": "My workspace",
  "ref": "workspace-1",
  "webhookUrl": "https://example.com/hooks/message-hub",
  "allowedOrigins": ["https://example.com"],
  "settings": {
    "theme": { "color": "#0b5fff", "radius": "lg" },
    "content": { "welcomeTitle": { "en": "Hi!", "vi": "Xin chào!" } }
  }
}
}

vars:post-response {
channelId: res.body.id
}
