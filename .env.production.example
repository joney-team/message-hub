# Runtime environment for a production container.
# NODE_ENV, PORT (4200), HOSTNAME and DATA_DIR (/data) are set by the image.

# Required. name:key pairs, comma separated; each key 16+ characters.
# Generate a key with: openssl rand -base64 32 | tr -d '=+/'
API_KEYS=admin:REPLACE_WITH_A_LONG_RANDOM_KEY

# Public HTTPS address of this app (no trailing slash). Makes file URLs in webhooks absolute.
PUBLIC_URL=https://message-hub.example.com

# Serve uploads from their own hostname (must point at this same app).
FILES_BASE_URL=https://files.message-hub.example.com

# Reverse proxies in front of the app that append to X-Forwarded-For.
# One reverse proxy = 1. A CDN in front of a reverse proxy usually means 2.
TRUSTED_PROXIES=1

# Optional
MAX_UPLOAD_MB=10
# 0 = keep conversations forever
MESSAGE_RETENTION_DAYS=0
# Set true temporarily while investigating operational issues. Logs omit message text and credentials.
DEBUG_LOG=false
