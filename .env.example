# Copy to .env.local for development. Never commit real keys.
# Required in production: name:key pairs, keys of 16+ characters. The name is the "owner" of channels.
API_KEYS=admin:change-me-to-a-long-random-key
DATA_DIR=./data
PORT=4200
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = none: header ignored).
# Must match the real deployment: with the app exposed directly, set 0.
TRUSTED_PROXIES=0
MAX_UPLOAD_MB=10
# Public URL of this app; used to make file URLs absolute in webhook payloads.
PUBLIC_URL=http://localhost:4200
# Optional: serve uploaded files from their own hostname.
# FILES_BASE_URL=https://files.example.com
# 0 = keep conversations forever.
MESSAGE_RETENTION_DAYS=0
